# Proem pool: the upstreams this proxy may route to.
#
# Credentials are never written here. Each member references an environment
# variable or a file, which Proem reads at request time.
members:
  - id: anthropic
    type: anthropic_api          # x-api-key
    cred:
      env: ANTHROPIC_API_KEY
      # file: /run/secrets/anthropic
    baseURL: https://api.anthropic.com
    weight: 3

  - id: openrouter
    type: openrouter             # Authorization: Bearer
    cred:
      env: OPENROUTER_KEY
    baseURL: https://openrouter.ai/api/v1
    weight: 1
    # Rewrites the model field for this member only, so clients can keep
    # asking for one name regardless of which member serves the request.
    modelMap:
      claude-sonnet-4-20250514: anthropic/claude-sonnet-4
      claude-haiku-4-5-20251001: anthropic/claude-haiku-4.5

  # A self-hosted or third-party Anthropic-compatible gateway.
  # - id: internal
  #   type: generic
  #   cred:
  #     file: /run/secrets/internal
  #   baseURL: https://gateway.internal
  #   cooldownSec: 60            # how long to skip it after a rate limit
  #   enabled: false             # keep the entry, exclude it from routing
